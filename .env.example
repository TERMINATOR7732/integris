# INTEGRIS Platform Configuration Example
# INTEGRIS operates entirely with zero persistence, no database, and no external AI APIs.
# Default configurations work out-of-the-box for local development.

# Backend CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Backend CORS Regex (for preview/cloud domains)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Frontend Backend API URL (set only in production when hosting frontend on a separate host)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
