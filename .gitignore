# ==============================================================================
# INTEGRIS Platform Git Exclusions
# Strict zero-leakage policy: no secrets, caches, environments, or builds tracked.
# Synthetic forensic datasets (datasets/*.csv) MUST remain tracked.
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
coverage/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/tsconfig.tsbuildinfo
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secrets (Strict: Never commit .env files)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# Operating System & IDE
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Cloud / Hosting build outputs
.vercel/
.netlify/

# Explicitly ensure synthetic demonstration datasets remain tracked
!datasets/
!datasets/*.csv
# Exclude large stress test datasets from Git tracking
*stress*.csv
datasets/*stress*.csv
test_*.json
*.pdf
integris_employee_attrition_forensics.csv


.vercel
