# INTEGRIS Backend Configuration Example
# All settings have safe defaults and run out-of-the-box for local development.

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Regex pattern for CORS origin matching (e.g., Vercel previews/deployments)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Upload constraint (default: 50 MB)
# MAX_UPLOAD_SIZE_BYTES=52428800
